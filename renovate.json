{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": false,
  "prCreation": "approval",
  "packageRules": [
    {
      "description": "Supply-chain cooldown: only offer a version once it has been public for a week. Limited to datasources whose registries report release timestamps, since Renovate 42 holds back any update it cannot date.",
      "matchDatasources": ["maven", "github-tags", "github-releases"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Kotlin",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/"
      ]
    },
    {
      "groupName": "Compose",
      "matchPackageNames": [
        "/^androidx\\.compose/"
      ]
    },
    {
      "groupName": "AndroidX",
      "matchPackageNames": [
        "/^androidx\\./",
        "!/^androidx\\.compose/"
      ]
    }
  ]
}
